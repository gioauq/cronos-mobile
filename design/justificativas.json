{"data":{"id":"2jtAiM2JJus","name":"Justificativas","activeVersion":1,"versions":[{"id":"gMCCktSeDeB","version":1,"code":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Justificativas</title>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@100;200;300;400;500;600;700;800&display=swap\"\n      rel=\"stylesheet\"\n    />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&display=swap\"\n      rel=\"stylesheet\"\n    />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800;900&display=swap\"\n      rel=\"stylesheet\"\n    />\n    <script src=\"https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4\"></script>\n    <script src=\"https://code.iconify.design/iconify-icon/3.0.0/iconify-icon.min.js\"></script>\n    <style type=\"text/tailwindcss\">\n      @theme inline {\n        --color-background: var(--background);\n        --color-foreground: var(--foreground);\n        --color-primary: var(--primary);\n        --color-primary-foreground: var(--primary-foreground);\n        --color-secondary: var(--secondary);\n        --color-secondary-foreground: var(--secondary-foreground);\n        --color-muted: var(--muted);\n        --color-muted-foreground: var(--muted-foreground);\n        --color-accent: var(--accent);\n        --color-accent-foreground: var(--accent-foreground);\n        --color-destructive: var(--destructive);\n        --color-card: var(--card);\n        --color-card-foreground: var(--card-foreground);\n        --color-popover: var(--popover);\n        --color-popover-foreground: var(--popover-foreground);\n        --color-border: var(--border);\n        --color-input: var(--input);\n        --color-ring: var(--ring);\n        --color-chart-1: var(--chart-1);\n        --color-chart-2: var(--chart-2);\n        --color-chart-3: var(--chart-3);\n        --color-chart-4: var(--chart-4);\n        --color-chart-5: var(--chart-5);\n\n        --font-font-sans: var(--font-sans);\n        --font-font-heading: var(--font-heading);\n        --font-font-serif: var(--font-serif);\n        --font-font-mono: var(--font-mono);\n      }\n\n      @theme {\n        --radius-xs: calc(var(--radius) - 8px);\n        --radius-sm: calc(var(--radius) - 4px);\n        --radius-md: calc(var(--radius) - 2px);\n        --radius-lg: var(--radius);\n        --radius-xl: calc(var(--radius) + 4px);\n        --radius-2xl: calc(var(--radius) + 8px);\n        --radius-3xl: calc(var(--radius) + 16px);\n        --radius-4xl: calc(var(--radius) + 24px);\n      }\n\n      * {\n        corner-shape: var(--shape, round);\n      }\n\n      .rounded-full,\n      .rounded-none,\n      .rounded-t-full,\n      .rounded-t-none,\n      .rounded-r-full,\n      .rounded-r-none,\n      .rounded-b-full,\n      .rounded-b-none,\n      .rounded-l-full,\n      .rounded-l-none,\n      .rounded-s-full,\n      .rounded-s-none,\n      .rounded-e-full,\n      .rounded-e-none,\n      .rounded-tl-full,\n      .rounded-tl-none,\n      .rounded-tr-full,\n      .rounded-tr-none,\n      .rounded-bl-full,\n      .rounded-bl-none,\n      .rounded-br-full,\n      .rounded-br-none,\n      .rounded-ss-full,\n      .rounded-ss-none,\n      .rounded-se-full,\n      .rounded-se-none,\n      .rounded-es-full,\n      .rounded-es-none,\n      .rounded-ee-full,\n      .rounded-ee-none {\n        corner-shape: round;\n      }\n\n      @utility rounded-* {\n        border-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-t-* {\n        border-top-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-top-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-r-* {\n        border-top-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-bottom-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-b-* {\n        border-bottom-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-bottom-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-l-* {\n        border-top-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-bottom-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-tl-* {\n        border-top-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-tr-* {\n        border-top-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-bl-* {\n        border-bottom-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-br-* {\n        border-bottom-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-s-* {\n        border-start-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-end-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-e-* {\n        border-start-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-end-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-ss-* {\n        border-start-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-se-* {\n        border-start-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-es-* {\n        border-end-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-ee-* {\n        border-end-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n\n      :root {\n        --shape: round;\n        --shape-multiplier: 1;\n\n        --background: #f4f6f8;\n        --foreground: #0f1f3d;\n        --primary: #0f1f3d;\n        --primary-foreground: #ffffff;\n        --secondary: #f59e0b;\n        --secondary-foreground: #ffffff;\n        --muted: #e2e8f0;\n        --muted-foreground: #64748b;\n        --accent: #00d0b6;\n        --accent-foreground: #00332d;\n        --destructive: #dc2626;\n        --card: #ffffff;\n        --card-foreground: #0f1f3d;\n        --popover: #ffffff;\n        --popover-foreground: #0f1f3d;\n        --border: #e2e8f0;\n        --input: #ffffff;\n        --ring: #00d0b6;\n        --chart-1: #00d0b6;\n        --chart-2: #f59e0b;\n        --chart-3: #0f1f3d;\n        --chart-4: #38bdf8;\n        --chart-5: #ef4444;\n\n        --font-sans: \"Inter\";\n        --font-heading: \"Inter\";\n        --font-serif: \"Playfair Display\";\n        --font-mono: \"JetBrains Mono\";\n\n        --radius: 0.75rem;\n      }\n\n      /* Prevent layout shift for icons without explicit dimensions */\n      iconify-icon:not([width]):not([height]) {\n        display: inline-block;\n        width: 1em;\n        height: 1em;\n      }\n\n      /* Hide scrollbars */\n      *,\n      *::before,\n      *::after {\n        scrollbar-width: none;\n        -ms-overflow-style: none;\n      }\n      *::-webkit-scrollbar {\n        display: none;\n      }\n    </style>\n  </head>\n  <body>\n    <div class=\"flex flex-col h-screen bg-background text-foreground font-sans\">\n      <header\n        class=\"bg-card border-b border-border pt-12 pb-5 px-6 sticky top-0 z-20 flex items-center gap-4\"\n      >\n        <button\n          class=\"w-10 h-10 rounded-full flex items-center justify-center bg-muted/50 text-primary\"\n        >\n          <iconify-icon icon=\"ph:arrow-left-bold\" width=\"20\" height=\"20\"></iconify-icon>\n        </button>\n        <h1 class=\"text-xl font-heading font-bold text-primary\">Justificativas</h1>\n      </header>\n      <main class=\"flex-1 overflow-y-auto pb-24 px-6\">\n        <div\n          class=\"mt-6 bg-card border border-border p-6 rounded-[24px] shadow-sm flex flex-col gap-5\"\n        >\n          <h2 class=\"text-sm font-bold text-muted-foreground uppercase tracking-widest\">\n            Nova Solicitação\n          </h2>\n          <div class=\"flex flex-col gap-4\">\n            <div>\n              <label\n                class=\"text-[10px] font-bold text-muted-foreground uppercase tracking-wider ml-1 mb-1.5 block\"\n                >Tipo de Ausência</label\n              >\n              <div class=\"relative\">\n                <select\n                  class=\"w-full bg-input border border-border rounded-xl px-4 py-3 text-sm font-medium appearance-none outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent transition-all\"\n                >\n                  <option>Selecione o tipo</option>\n                  <option>Férias</option>\n                  <option>Atestado Médico</option>\n                  <option>Viagem a Serviço</option>\n                  <option>Amamentação</option>\n                  <option>Curso</option>\n                  <option>Licença</option>\n                  <option>Abono</option>\n                  <option>Outros</option></select\n                ><iconify-icon\n                  icon=\"ph:caret-down-bold\"\n                  width=\"16\"\n                  height=\"16\"\n                  class=\"absolute right-4 top-1/2 -translate-y-1/2 text-muted-foreground pointer-events-none\"\n                ></iconify-icon>\n              </div>\n            </div>\n            <div class=\"grid grid-cols-2 gap-4\">\n              <div>\n                <label\n                  class=\"text-[10px] font-bold text-muted-foreground uppercase tracking-wider ml-1 mb-1.5 block\"\n                  >Data Início</label\n                ><input\n                  type=\"date\"\n                  class=\"w-full bg-input border border-border rounded-xl px-4 py-3 text-sm font-medium outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent transition-all\"\n                />\n              </div>\n              <div>\n                <label\n                  class=\"text-[10px] font-bold text-muted-foreground uppercase tracking-wider ml-1 mb-1.5 block\"\n                  >Data Fim</label\n                ><input\n                  type=\"date\"\n                  class=\"w-full bg-input border border-border rounded-xl px-4 py-3 text-sm font-medium outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent transition-all\"\n                />\n              </div>\n            </div>\n            <div>\n              <label\n                class=\"text-[10px] font-bold text-muted-foreground uppercase tracking-wider ml-1 mb-1.5 block\"\n                >Motivo / Descrição</label\n              ><textarea\n                class=\"w-full bg-input border border-border rounded-xl px-4 py-3 text-sm font-medium outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent transition-all h-24 resize-none\"\n                placeholder=\"Descreva brevemente o motivo...\"\n              ></textarea>\n            </div>\n            <button\n              class=\"w-full border-2 border-dashed border-border rounded-xl py-4 flex flex-col items-center gap-1 text-muted-foreground hover:bg-muted/30 transition-colors\"\n            >\n              <iconify-icon icon=\"ph:paperclip-bold\" width=\"24\" height=\"24\"></iconify-icon\n              ><span class=\"text-xs font-bold uppercase tracking-wide\"\n                >Anexar Documento</span\n              ></button\n            ><button\n              class=\"w-full bg-primary text-primary-foreground py-4 rounded-xl font-bold text-sm shadow-lg shadow-primary/20 active:scale-95 transition-transform mt-2\"\n            >\n              ENVIAR SOLICITAÇÃO\n            </button>\n          </div>\n        </div>\n        <div class=\"mt-8 mb-4 flex items-center justify-between\">\n          <h2 class=\"text-xs font-bold text-muted-foreground uppercase tracking-widest\">\n            Minhas Solicitações\n          </h2>\n          <button class=\"text-xs font-bold text-accent tracking-wide\">VER TODAS</button>\n        </div>\n        <div class=\"flex flex-col gap-3 pb-8\">\n          <div class=\"bg-card border border-border p-4 rounded-2xl flex flex-col gap-3\">\n            <div class=\"flex items-start justify-between\">\n              <div>\n                <h3 class=\"text-sm font-bold text-primary\">Atestado Médico</h3>\n                <p class=\"text-[10px] text-muted-foreground font-medium\">Enviado em 22 Nov, 2023</p>\n              </div>\n              <span\n                class=\"bg-secondary/10 text-secondary border border-secondary/20 px-2 py-1 rounded-md text-[10px] font-bold uppercase\"\n                >Pendente</span\n              >\n            </div>\n            <div class=\"flex items-center gap-4 text-xs font-medium text-muted-foreground\">\n              <div class=\"flex items-center gap-1\">\n                <iconify-icon icon=\"ph:calendar-bold\" width=\"14\" height=\"14\"></iconify-icon>22 Nov -\n                22 Nov\n              </div>\n              <div class=\"flex items-center gap-1\">\n                <iconify-icon icon=\"ph:file-bold\" width=\"14\" height=\"14\"></iconify-icon>atestado.pdf\n              </div>\n            </div>\n          </div>\n          <div class=\"bg-card border border-border p-4 rounded-2xl flex flex-col gap-3\">\n            <div class=\"flex items-start justify-between\">\n              <div>\n                <h3 class=\"text-sm font-bold text-primary\">Curso Presencial</h3>\n                <p class=\"text-[10px] text-muted-foreground font-medium\">Enviado em 15 Out, 2023</p>\n              </div>\n              <span\n                class=\"bg-accent/10 text-accent border border-accent/20 px-2 py-1 rounded-md text-[10px] font-bold uppercase\"\n                >Aprovada</span\n              >\n            </div>\n            <div class=\"flex items-center gap-4 text-xs font-medium text-muted-foreground\">\n              <div class=\"flex items-center gap-1\">\n                <iconify-icon icon=\"ph:calendar-bold\" width=\"14\" height=\"14\"></iconify-icon>18 Out -\n                19 Out\n              </div>\n              <div class=\"flex items-center gap-1\">\n                <iconify-icon icon=\"ph:file-bold\" width=\"14\" height=\"14\"></iconify-icon\n                >certificado.png\n              </div>\n            </div>\n          </div>\n          <div class=\"bg-card border border-border p-4 rounded-2xl flex flex-col gap-3 opacity-75\">\n            <div class=\"flex items-start justify-between\">\n              <div>\n                <h3 class=\"text-sm font-bold text-primary\">Viagem a Serviço</h3>\n                <p class=\"text-[10px] text-muted-foreground font-medium\">Enviado em 05 Out, 2023</p>\n              </div>\n              <span\n                class=\"bg-destructive/10 text-destructive border border-destructive/20 px-2 py-1 rounded-md text-[10px] font-bold uppercase\"\n                >Reprovada</span\n              >\n            </div>\n            <p\n              class=\"text-xs text-destructive font-medium bg-destructive/5 p-2 rounded-lg border border-destructive/10\"\n            >\n              Motivo: Falta de comprovante de hospedagem anexado.\n            </p>\n          </div>\n        </div>\n      </main>\n    </div>\n  </body>\n</html>\n","createdAt":"2026-07-23T05:30:49.628928+00:00"}],"createdAt":"2026-07-23T05:30:49.628928+00:00","updatedAt":"2026-07-23T05:30:49.628928+00:00"}}