{"data":{"id":"6Ov2g99mfid","name":"Login","activeVersion":1,"versions":[{"id":"PoOWilPm9er","version":1,"code":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Login</title>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@100;200;300;400;500;600;700;800&display=swap\"\n      rel=\"stylesheet\"\n    />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&display=swap\"\n      rel=\"stylesheet\"\n    />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800;900&display=swap\"\n      rel=\"stylesheet\"\n    />\n    <script src=\"https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4\"></script>\n    <script src=\"https://code.iconify.design/iconify-icon/3.0.0/iconify-icon.min.js\"></script>\n    <style type=\"text/tailwindcss\">\n      @theme inline {\n        --color-background: var(--background);\n        --color-foreground: var(--foreground);\n        --color-primary: var(--primary);\n        --color-primary-foreground: var(--primary-foreground);\n        --color-secondary: var(--secondary);\n        --color-secondary-foreground: var(--secondary-foreground);\n        --color-muted: var(--muted);\n        --color-muted-foreground: var(--muted-foreground);\n        --color-accent: var(--accent);\n        --color-accent-foreground: var(--accent-foreground);\n        --color-destructive: var(--destructive);\n        --color-card: var(--card);\n        --color-card-foreground: var(--card-foreground);\n        --color-popover: var(--popover);\n        --color-popover-foreground: var(--popover-foreground);\n        --color-border: var(--border);\n        --color-input: var(--input);\n        --color-ring: var(--ring);\n        --color-chart-1: var(--chart-1);\n        --color-chart-2: var(--chart-2);\n        --color-chart-3: var(--chart-3);\n        --color-chart-4: var(--chart-4);\n        --color-chart-5: var(--chart-5);\n\n        --font-font-sans: var(--font-sans);\n        --font-font-heading: var(--font-heading);\n        --font-font-serif: var(--font-serif);\n        --font-font-mono: var(--font-mono);\n      }\n\n      @theme {\n        --radius-xs: calc(var(--radius) - 8px);\n        --radius-sm: calc(var(--radius) - 4px);\n        --radius-md: calc(var(--radius) - 2px);\n        --radius-lg: var(--radius);\n        --radius-xl: calc(var(--radius) + 4px);\n        --radius-2xl: calc(var(--radius) + 8px);\n        --radius-3xl: calc(var(--radius) + 16px);\n        --radius-4xl: calc(var(--radius) + 24px);\n      }\n\n      * {\n        corner-shape: var(--shape, round);\n      }\n\n      .rounded-full,\n      .rounded-none,\n      .rounded-t-full,\n      .rounded-t-none,\n      .rounded-r-full,\n      .rounded-r-none,\n      .rounded-b-full,\n      .rounded-b-none,\n      .rounded-l-full,\n      .rounded-l-none,\n      .rounded-s-full,\n      .rounded-s-none,\n      .rounded-e-full,\n      .rounded-e-none,\n      .rounded-tl-full,\n      .rounded-tl-none,\n      .rounded-tr-full,\n      .rounded-tr-none,\n      .rounded-bl-full,\n      .rounded-bl-none,\n      .rounded-br-full,\n      .rounded-br-none,\n      .rounded-ss-full,\n      .rounded-ss-none,\n      .rounded-se-full,\n      .rounded-se-none,\n      .rounded-es-full,\n      .rounded-es-none,\n      .rounded-ee-full,\n      .rounded-ee-none {\n        corner-shape: round;\n      }\n\n      @utility rounded-* {\n        border-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-t-* {\n        border-top-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-top-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-r-* {\n        border-top-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-bottom-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-b-* {\n        border-bottom-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-bottom-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-l-* {\n        border-top-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-bottom-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-tl-* {\n        border-top-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-tr-* {\n        border-top-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-bl-* {\n        border-bottom-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-br-* {\n        border-bottom-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-s-* {\n        border-start-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-end-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-e-* {\n        border-start-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-end-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-ss-* {\n        border-start-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-se-* {\n        border-start-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-es-* {\n        border-end-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-ee-* {\n        border-end-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n\n      :root {\n        --shape: round;\n        --shape-multiplier: 1;\n\n        --background: #f4f6f8;\n        --foreground: #0f1f3d;\n        --primary: #0f1f3d;\n        --primary-foreground: #ffffff;\n        --secondary: #f59e0b;\n        --secondary-foreground: #ffffff;\n        --muted: #e2e8f0;\n        --muted-foreground: #64748b;\n        --accent: #00d0b6;\n        --accent-foreground: #00332d;\n        --destructive: #dc2626;\n        --card: #ffffff;\n        --card-foreground: #0f1f3d;\n        --popover: #ffffff;\n        --popover-foreground: #0f1f3d;\n        --border: #e2e8f0;\n        --input: #ffffff;\n        --ring: #00d0b6;\n        --chart-1: #00d0b6;\n        --chart-2: #f59e0b;\n        --chart-3: #0f1f3d;\n        --chart-4: #38bdf8;\n        --chart-5: #ef4444;\n\n        --font-sans: \"Inter\";\n        --font-heading: \"Inter\";\n        --font-serif: \"Playfair Display\";\n        --font-mono: \"JetBrains Mono\";\n\n        --radius: 0.75rem;\n      }\n\n      /* Prevent layout shift for icons without explicit dimensions */\n      iconify-icon:not([width]):not([height]) {\n        display: inline-block;\n        width: 1em;\n        height: 1em;\n      }\n\n      /* Hide scrollbars */\n      *,\n      *::before,\n      *::after {\n        scrollbar-width: none;\n        -ms-overflow-style: none;\n      }\n      *::-webkit-scrollbar {\n        display: none;\n      }\n    </style>\n  </head>\n  <body>\n    <div class=\"flex flex-col h-screen bg-background text-foreground px-8 font-sans\">\n      <div class=\"flex-1 flex flex-col justify-center gap-12 max-w-sm mx-auto w-full\">\n        <div class=\"flex flex-col items-center gap-3\">\n          <div\n            class=\"bg-primary text-primary-foreground p-4 rounded-3xl shadow-lg shadow-primary/20\"\n          >\n            <iconify-icon icon=\"ph:timer-bold\" width=\"48\" height=\"48\"></iconify-icon>\n          </div>\n          <div class=\"text-center\">\n            <h1 class=\"text-4xl font-heading font-bold text-primary tracking-tight\">Cronos</h1>\n            <p class=\"text-muted-foreground font-medium mt-1\">Controle de ponto seguro e preciso</p>\n          </div>\n        </div>\n        <div class=\"flex flex-col gap-6\">\n          <div class=\"flex flex-col gap-4\">\n            <div class=\"flex flex-col gap-2\">\n              <label\n                for=\"email\"\n                class=\"text-xs font-bold text-muted-foreground uppercase tracking-widest ml-1\"\n                >E-mail corporativo</label\n              ><input\n                id=\"email\"\n                type=\"email\"\n                class=\"bg-input border border-border h-14 rounded-2xl px-5 text-base focus:ring-2 focus:ring-accent focus:border-transparent outline-none transition-all\"\n                placeholder=\"nome.sobrenome@empresa.com\"\n              />\n            </div>\n            <div class=\"flex flex-col gap-2\">\n              <label\n                for=\"password\"\n                class=\"text-xs font-bold text-muted-foreground uppercase tracking-widest ml-1\"\n                >Senha</label\n              >\n              <div class=\"relative\">\n                <input\n                  id=\"password\"\n                  type=\"password\"\n                  class=\"bg-input border border-border h-14 rounded-2xl px-5 w-full text-base focus:ring-2 focus:ring-accent focus:border-transparent outline-none transition-all\"\n                  placeholder=\"••••••••\"\n                /><button class=\"absolute right-4 top-1/2 -translate-y-1/2 text-muted-foreground\">\n                  <iconify-icon icon=\"ph:eye-bold\" width=\"20\" height=\"20\"></iconify-icon>\n                </button>\n              </div>\n            </div>\n          </div>\n          <button\n            class=\"bg-primary text-primary-foreground h-14 rounded-full font-heading font-bold text-lg hover:bg-primary/90 active:scale-95 transition-all shadow-lg shadow-primary/20\"\n          >\n            Entrar\n          </button>\n          <div class=\"flex flex-col items-center gap-4\">\n            <a\n              href=\"#\"\n              class=\"text-sm font-semibold text-primary/70 hover:text-primary transition-colors\"\n              >Esqueci minha senha</a\n            >\n            <div class=\"flex items-center gap-4 w-full px-4\">\n              <div class=\"h-px bg-border flex-1\"></div>\n              <span class=\"text-xs font-bold text-muted-foreground uppercase tracking-widest\"\n                >Acesso Restrito</span\n              >\n              <div class=\"h-px bg-border flex-1\"></div>\n            </div>\n            <p\n              class=\"text-[10px] text-muted-foreground text-center uppercase leading-relaxed tracking-wider\"\n            >\n              Ao entrar, você concorda com os termos de uso e políticas de privacidade da sua\n              empresa.\n            </p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </body>\n</html>\n","createdAt":"2026-07-13T01:19:46.508694+00:00"}],"createdAt":"2026-07-13T01:19:46.508694+00:00","updatedAt":"2026-07-13T01:19:46.508694+00:00"}}