{"data":{"id":"Kd8nWk0LPNB","name":"Home","activeVersion":1,"versions":[{"id":"c7vPfnWsPTN","version":1,"code":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Home</title>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@100;200;300;400;500;600;700;800&display=swap\"\n      rel=\"stylesheet\"\n    />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&display=swap\"\n      rel=\"stylesheet\"\n    />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800;900&display=swap\"\n      rel=\"stylesheet\"\n    />\n    <script src=\"https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4\"></script>\n    <script src=\"https://code.iconify.design/iconify-icon/3.0.0/iconify-icon.min.js\"></script>\n    <style type=\"text/tailwindcss\">\n      @theme inline {\n        --color-background: var(--background);\n        --color-foreground: var(--foreground);\n        --color-primary: var(--primary);\n        --color-primary-foreground: var(--primary-foreground);\n        --color-secondary: var(--secondary);\n        --color-secondary-foreground: var(--secondary-foreground);\n        --color-muted: var(--muted);\n        --color-muted-foreground: var(--muted-foreground);\n        --color-accent: var(--accent);\n        --color-accent-foreground: var(--accent-foreground);\n        --color-destructive: var(--destructive);\n        --color-card: var(--card);\n        --color-card-foreground: var(--card-foreground);\n        --color-popover: var(--popover);\n        --color-popover-foreground: var(--popover-foreground);\n        --color-border: var(--border);\n        --color-input: var(--input);\n        --color-ring: var(--ring);\n        --color-chart-1: var(--chart-1);\n        --color-chart-2: var(--chart-2);\n        --color-chart-3: var(--chart-3);\n        --color-chart-4: var(--chart-4);\n        --color-chart-5: var(--chart-5);\n\n        --font-font-sans: var(--font-sans);\n        --font-font-heading: var(--font-heading);\n        --font-font-serif: var(--font-serif);\n        --font-font-mono: var(--font-mono);\n      }\n\n      @theme {\n        --radius-xs: calc(var(--radius) - 8px);\n        --radius-sm: calc(var(--radius) - 4px);\n        --radius-md: calc(var(--radius) - 2px);\n        --radius-lg: var(--radius);\n        --radius-xl: calc(var(--radius) + 4px);\n        --radius-2xl: calc(var(--radius) + 8px);\n        --radius-3xl: calc(var(--radius) + 16px);\n        --radius-4xl: calc(var(--radius) + 24px);\n      }\n\n      * {\n        corner-shape: var(--shape, round);\n      }\n\n      .rounded-full,\n      .rounded-none,\n      .rounded-t-full,\n      .rounded-t-none,\n      .rounded-r-full,\n      .rounded-r-none,\n      .rounded-b-full,\n      .rounded-b-none,\n      .rounded-l-full,\n      .rounded-l-none,\n      .rounded-s-full,\n      .rounded-s-none,\n      .rounded-e-full,\n      .rounded-e-none,\n      .rounded-tl-full,\n      .rounded-tl-none,\n      .rounded-tr-full,\n      .rounded-tr-none,\n      .rounded-bl-full,\n      .rounded-bl-none,\n      .rounded-br-full,\n      .rounded-br-none,\n      .rounded-ss-full,\n      .rounded-ss-none,\n      .rounded-se-full,\n      .rounded-se-none,\n      .rounded-es-full,\n      .rounded-es-none,\n      .rounded-ee-full,\n      .rounded-ee-none {\n        corner-shape: round;\n      }\n\n      @utility rounded-* {\n        border-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-t-* {\n        border-top-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-top-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-r-* {\n        border-top-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-bottom-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-b-* {\n        border-bottom-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-bottom-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-l-* {\n        border-top-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-bottom-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-tl-* {\n        border-top-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-tr-* {\n        border-top-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-bl-* {\n        border-bottom-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-br-* {\n        border-bottom-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-s-* {\n        border-start-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-end-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-e-* {\n        border-start-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-end-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-ss-* {\n        border-start-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-se-* {\n        border-start-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-es-* {\n        border-end-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-ee-* {\n        border-end-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n\n      :root {\n        --shape: round;\n        --shape-multiplier: 1;\n\n        --background: #f4f6f8;\n        --foreground: #0f1f3d;\n        --primary: #0f1f3d;\n        --primary-foreground: #ffffff;\n        --secondary: #f59e0b;\n        --secondary-foreground: #ffffff;\n        --muted: #e2e8f0;\n        --muted-foreground: #64748b;\n        --accent: #00d0b6;\n        --accent-foreground: #00332d;\n        --destructive: #dc2626;\n        --card: #ffffff;\n        --card-foreground: #0f1f3d;\n        --popover: #ffffff;\n        --popover-foreground: #0f1f3d;\n        --border: #e2e8f0;\n        --input: #ffffff;\n        --ring: #00d0b6;\n        --chart-1: #00d0b6;\n        --chart-2: #f59e0b;\n        --chart-3: #0f1f3d;\n        --chart-4: #38bdf8;\n        --chart-5: #ef4444;\n\n        --font-sans: \"Inter\";\n        --font-heading: \"Inter\";\n        --font-serif: \"Playfair Display\";\n        --font-mono: \"JetBrains Mono\";\n\n        --radius: 0.75rem;\n      }\n\n      /* Prevent layout shift for icons without explicit dimensions */\n      iconify-icon:not([width]):not([height]) {\n        display: inline-block;\n        width: 1em;\n        height: 1em;\n      }\n\n      /* Hide scrollbars */\n      *,\n      *::before,\n      *::after {\n        scrollbar-width: none;\n        -ms-overflow-style: none;\n      }\n      *::-webkit-scrollbar {\n        display: none;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      class=\"flex flex-col h-screen bg-background text-foreground relative overflow-hidden font-sans\"\n    >\n      <div\n        class=\"bg-secondary text-secondary-foreground text-sm font-medium px-4 py-2 flex items-center justify-center gap-2\"\n      >\n        <iconify-icon icon=\"ph:wifi-slash-bold\" width=\"16\" height=\"16\"></iconify-icon>Modo offline.\n        Batidas serão sincronizadas depois.\n      </div>\n      <header class=\"px-6 py-5 flex items-center justify-between\">\n        <div class=\"flex flex-col\">\n          <h1 class=\"text-xl font-heading font-semibold text-primary\">Cronos</h1>\n          <p class=\"text-sm text-muted-foreground\">Sexta, 24 de Novembro</p>\n        </div>\n        <div\n          class=\"bg-secondary/10 text-secondary border border-secondary/20 rounded-full px-3 py-1 text-xs font-semibold flex items-center gap-1.5\"\n        >\n          <iconify-icon icon=\"ph:arrows-clockwise-bold\" width=\"14\" height=\"14\"></iconify-icon>2\n          pendentes\n        </div>\n      </header>\n      <main class=\"flex-1 flex flex-col items-center justify-center px-6 pb-24 gap-10\">\n        <div class=\"flex flex-col items-center gap-1\">\n          <div class=\"text-6xl text-primary font-semibold tabular-nums tracking-tight\">08:58</div>\n          <div class=\"text-base text-muted-foreground font-medium uppercase tracking-widest\">\n            Horário de Brasília\n          </div>\n        </div>\n        <div class=\"flex flex-col items-center gap-4 w-full\">\n          <span class=\"text-sm font-medium text-muted-foreground uppercase tracking-wide\"\n            >Próximo registro</span\n          ><button\n            class=\"relative group bg-accent text-accent-foreground hover:bg-accent/90 active:scale-95 transition-all duration-200 rounded-full w-64 h-64 flex flex-col items-center justify-center gap-3 shadow-[0_0_40px_rgba(0,208,182,0.3)]\"\n          >\n            <div\n              class=\"absolute inset-0 rounded-full border-2 border-accent animate-ping opacity-20\"\n            ></div>\n            <iconify-icon icon=\"ph:fingerprint-simple-bold\" width=\"64\" height=\"64\"></iconify-icon\n            ><span class=\"text-2xl font-heading font-bold\">Entrada</span>\n          </button>\n        </div>\n        <div\n          class=\"bg-card border border-border p-3 rounded-2xl flex items-center gap-4 w-full max-w-sm mt-4 shadow-sm\"\n        >\n          <div class=\"w-16 h-16 rounded-xl overflow-hidden relative shrink-0 border border-border\">\n            <img\n              alt=\"Map Thumbnail\"\n              src=\"https://ggrhecslgdflloszjkwl.supabase.co/storage/v1/object/public/user-assets/RMEU1ltkTrQ/components/8YSgA7qH4iB.jpeg\"\n              class=\"w-full h-full object-cover\"\n            />\n            <div class=\"absolute inset-0 flex items-center justify-center\">\n              <iconify-icon\n                icon=\"ph:map-pin-fill\"\n                class=\"text-accent drop-shadow-md\"\n                width=\"24\"\n                height=\"24\"\n              ></iconify-icon>\n            </div>\n          </div>\n          <div class=\"flex flex-col flex-1 min-w-0\">\n            <span\n              class=\"text-xs font-semibold text-accent uppercase tracking-wide flex items-center gap-1 mb-0.5\"\n              ><iconify-icon icon=\"ph:check-circle-fill\" width=\"14\" height=\"14\"></iconify-icon\n              >Localização Obtida</span\n            ><span class=\"text-sm font-medium text-foreground truncate\"\n              >Av. Eng. Luís Carlos Berrini, 1500</span\n            ><span class=\"text-xs text-muted-foreground tabular-nums truncate\"\n              >-23.6067, -46.6946</span\n            >\n          </div>\n        </div>\n      </main>\n      <nav\n        class=\"absolute bottom-0 w-full bg-card border-t border-border flex items-center justify-between pb-safe pt-2 px-6 h-20 shadow-[0_-4px_24px_rgba(0,0,0,0.02)] z-10\"\n      >\n        <button class=\"flex flex-col items-center gap-1 text-primary flex-1\">\n          <iconify-icon icon=\"ph:clock-fill\" width=\"24\" height=\"24\"></iconify-icon\n          ><span class=\"text-[10px] font-semibold\">Bater Ponto</span></button\n        ><button\n          class=\"flex flex-col items-center gap-1 text-muted-foreground hover:text-foreground transition-colors flex-1\"\n        >\n          <iconify-icon icon=\"ph:list-dashes-bold\" width=\"24\" height=\"24\"></iconify-icon\n          ><span class=\"text-[10px] font-medium\">Histórico</span></button\n        ><button\n          class=\"flex flex-col items-center gap-1 text-muted-foreground hover:text-foreground transition-colors flex-1\"\n        >\n          <iconify-icon icon=\"ph:user-bold\" width=\"24\" height=\"24\"></iconify-icon\n          ><span class=\"text-[10px] font-medium\">Perfil</span>\n        </button>\n      </nav>\n    </div>\n  </body>\n</html>\n","createdAt":"2026-07-13T01:19:46.352912+00:00"}],"createdAt":"2026-07-13T01:19:46.352912+00:00","updatedAt":"2026-07-13T01:19:46.352912+00:00"}}