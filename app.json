{
  "expo": {
    "name": "Cronos",
    "slug": "cronos-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "br.com.pontocronos",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O Cronos usa sua localização para registrar onde cada marcação de ponto foi feita.",
        "NSCameraUsageDescription": "O Cronos usa a câmera para tirar a selfie obrigatória de cada marcação de ponto.",
        "NSPhotoLibraryUsageDescription": "O Cronos acessa suas fotos para você escolher a foto de perfil ou anexar comprovantes às justificativas.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "br.com.pontocronos.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F1F3D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Cronos usa sua localização para registrar onde cada marcação de ponto foi feita."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Cronos usa a câmera para tirar a selfie obrigatória de cada marcação de ponto.",
          "photosPermission": "O Cronos acessa suas fotos para você escolher a foto de perfil ou anexar comprovantes às justificativas.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "color": "#0F1F3D"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0F1F3D"
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "1eb2dbb9-2208-461a-a6c6-fc03d22cdac9"
      }
    },
    "owner": "gioauq"
  }
}
